# ---------------------------------------------------------------------------
# Saakshya (Indian Phone OSINT Research Engine) - environment configuration
# Copy to .env and fill in only the providers you have accounts for.
# Every provider is optional; missing keys simply disable that provider.
# NEVER commit .env.  Keys are never logged.
# ---------------------------------------------------------------------------

# ===== Search providers (at least one recommended) =========================
# Brave Search API  - PRIMARY. $5 free credit / month (~1,000 queries), then $5 per 1,000.
#   https://brave.com/search/api/   (header: X-Subscription-Token)
BRAVE_API_KEY=

# SerpAPI (Google / Bing / DuckDuckGo / Yandex / Google Lens via a scrape-on-your-behalf service)
#   PAID OPTIONAL PROVIDER - free 250 searches / month.  https://serpapi.com/pricing
SERPAPI_KEY=

# Serper.dev (Google SERP proxy) - PAID OPTIONAL PROVIDER - 2,500 free queries then from $0.30/1k
SERPER_API_KEY=

# Tavily (AI search API with exact_match + include_domains) - free 1,000 credits / month
TAVILY_API_KEY=

# Google Programmable Search JSON API - DEPRECATED: closed to new customers, shuts down 2027-01-01.
# Only works if you already have an existing CSE project.  100 free queries / day.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ===== Phone / telecom intelligence =========================================
# libphonenumber (offline) is always on.  The following are optional corroboration sources.
# Veriphone - free 1,000 credits / month.  https://veriphone.io
VERIPHONE_API_KEY=
# NumVerify (apilayer marketplace key) - free 100 requests / month.  https://apilayer.com/marketplace/number_verification-api
NUMVERIFY_API_KEY=
# AbstractAPI phone validation - free 100 requests.  https://www.abstractapi.com/api/phone-validation-api
ABSTRACT_PHONE_API_KEY=
# Twilio Lookup v2 - PAID OPTIONAL PROVIDER ($0.008 per line-type-intelligence request)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# PhoneInfoga sidecar (optional, unmaintained upstream). Run: phoneinfoga serve --no-client (binds :5000)
PHONEINFOGA_URL=

# ===== Business / social / image / registry ==================================
# Google Places API (New) - phone-number text search; monthly free credit then paid
GOOGLE_PLACES_API_KEY=
# GitHub token (raises the public REST API rate limit for username checks; public data only)
GITHUB_TOKEN=
# YouTube Data API key (public channel search; optional)
YOUTUBE_API_KEY=
# TinEye reverse image search - PAID OPTIONAL PROVIDER
TINEYE_API_KEY=
# Indian Kanoon API (public judgments full-text search) - PAID OPTIONAL PROVIDER (per-request pricing)
INDIANKANOON_API_TOKEN=

# ===== Engine behaviour =====================================================
OSINT_USER_AGENT=IndianPhoneOSINT/0.1 (+public-source research; respects robots.txt)
OSINT_DATA_DIR=data
OSINT_OUTPUT_DIR=output
OSINT_CACHE_TTL_HOURS=72
OSINT_RESPECT_ROBOTS=true
OSINT_HTTP_TIMEOUT=20
OSINT_HTTP_MAX_RETRIES=3
OSINT_MAX_CONCURRENCY=6
OSINT_PER_HOST_RATE=1.0
OSINT_MAX_FETCH_BYTES=5000000
OSINT_LOG_LEVEL=INFO
OSINT_LOG_JSON=false
# Search-API terms (e.g. Brave) restrict building databases of result snippets.  When false (default),
# the persistent evidence store keeps only URLs, titles and OUR OWN page excerpts, not provider snippets.
OSINT_STORE_PROVIDER_SNIPPETS=false
